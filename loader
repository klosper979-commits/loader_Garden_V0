-- перетаскивание окна (мышь + тач)
local dragging, dragStart, startPos
frame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = frame.Position
	end
end)
UIS.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local d = input.Position - dragStart
		frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
	end
end)
UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

-- ===== ПРОВЕРКА: НИК (авто) + КЛЮЧ НЕДЕЛИ =====
local busy = false
local function activate()
	if busy then return end
	busy = true
	local input = box.Text:match("^%s*(.-)%s*$")
	if input == "" then
		status.Text = "Please enter the weekly key!"
		busy = false
		return
	end
	status.Text = "⏳ Verifying access..."
	local ok, res = pcall(function()
		return game:HttpGet(WORKER_URL .. "/?user=" .. HttpService:UrlEncode(MY_NAME)
			.. "&uid=" .. tostring(MY_ID)
			.. "&key=" .. HttpService:UrlEncode(input))
	end)
	if not ok then
		status.Text = "⚠️ Server unreachable, try again later"
	elseif res:sub(1, 3) == "OK\n" then
		status.Text = "✅ Access granted! Loading autofarm..."
		task.wait(0.6)
		gui:Destroy()
		local chunk = res:sub(4)
		local fn, cerr = loadstring(chunk)
		if fn then
			task.spawn(function()
				local ok2, err2 = pcall(fn)
				if not ok2 then warn("Autofarm error: " .. tostring(err2)) end
			end)
		else
			warn("Script corrupted in transfer: " .. tostring(cerr))
		end
		return
	elseif res == "ERR|denied" then
		status.Text = "❌ Not whitelisted. Contact the seller: " .. MY_NAME .. " (ID: " .. tostring(MY_ID) .. ")"
	elseif res == "ERR|badkey" then
		status.Text = "❌ Wrong or expired key. Ask the seller for this week's key"
	else
		status.Text = "⚠️ Unexpected server response"
	end
	busy = false
end

btn.MouseButton1Click:Connect(activate)
box.FocusLost:Connect(function(enter) if enter then activate() end end)

print("🔑 Loader v6 started — account: " .. MY_NAME)
