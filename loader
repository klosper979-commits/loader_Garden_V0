-- 🔑 LOADER v3 EN (public): ключ проверяется на сервере Cloudflare
-- В этом файле НЕТ секретов: ни ключей, ни скрипта. Всё скрыто на сервере.
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local player = Players.LocalPlayer


local WORKER_URL = "https://garden-gate.klosper979.workers.dev"


-- ===== GUI =====
local gui = Instance.new("ScreenGui")
gui.Name = "GardenLoader"
gui.ResetOnSpawn = false
local okHui, hui = pcall(function() return gethui() end)
gui.Parent = (okHui and hui) or player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 320, 0, 170)
frame.Position = UDim2.new(0.5, -160, 0.5, -85)
frame.BackgroundColor3 = Color3.fromRGB(24, 26, 32)
frame.BorderSizePixel = 0
frame.Active = true
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 36)
title.BackgroundTransparency = 1
title.Text = "🌻 Garden TD — Autofarm"
title.TextColor3 = Color3.fromRGB(255, 220, 90)
title.Font = Enum.Font.GothamBold
title.TextSize = 16
title.Parent = frame

local box = Instance.new("TextBox")
box.Size = UDim2.new(1, -32, 0, 36)
box.Position = UDim2.new(0, 16, 0, 44)
box.BackgroundColor3 = Color3.fromRGB(40, 43, 52)
box.TextColor3 = Color3.fromRGB(255, 255, 255)
box.PlaceholderText = "Enter your key..."
box.PlaceholderColor3 = Color3.fromRGB(120, 124, 135)
box.Text = ""
box.Font = Enum.Font.Gotham
box.TextSize = 14
box.ClearTextOnFocus = false
box.Parent = frame
Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(1, -32, 0, 36)
btn.Position = UDim2.new(0, 16, 0, 90)
btn.BackgroundColor3 = Color3.fromRGB(88, 160, 80)
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.Text = "🚀 Launch"
btn.Font = Enum.Font.GothamBold
btn.TextSize = 14
btn.Parent = frame
Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, 0, 0, 24)
status.Position = UDim2.new(0, 0, 0, 134)
status.BackgroundTransparency = 1
status.Text = ""
status.TextColor3 = Color3.fromRGB(200, 200, 200)
status.Font = Enum.Font.Gotham
status.TextSize = 13
status.Parent = frame

-- перетаскивание окна (мышь + тач)
local dragging, dragStart, startPos
frame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = frame.Position
	end
end)
UIS.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local d = input.Position - dragStart
		frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
	end
end)
UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

-- ===== ПРОВЕРКА КЛЮЧА НА СЕРВЕРЕ + ЗАГРУЗКА СКРИПТА =====
local busy = false
local function activate()
	if busy then return end
	busy = true
	local input = box.Text:match("^%s*(.-)%s*$")
	if input == "" then
		status.Text = "Please enter a key!"
		busy = false
		return
	end
	status.Text = "⏳ Verifying key..."
	local ok, res = pcall(function()
		return game:HttpGet(WORKER_URL .. "/?key=" .. HttpService:UrlEncode(input))
	end)
	if not ok then
		status.Text = "⚠️ Server unreachable, try again later"
	elseif res:sub(1, 3) == "OK\n" then
		status.Text = "✅ Key valid! Loading autofarm..."
		task.wait(0.6)
		gui:Destroy()
		local chunk = res:sub(4)
		local fn, cerr = loadstring(chunk)
		if fn then
			task.spawn(function()
				local ok2, err2 = pcall(fn)
				if not ok2 then warn("Autofarm error: " .. tostring(err2)) end
			end)
		else
			warn("Script corrupted in transfer: " .. tostring(cerr))
		end
		return
	else
		status.Text = "❌ Invalid key"
	end
	busy = false
end

btn.MouseButton1Click:Connect(activate)
box.FocusLost:Connect(function(enter) if enter then activate() end end)

print("🔑 Loader v3 started — enter your key")
